{
    "name": "nilsh.ch",
    "version": "0.4.3",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint --fix",
        "prettier-check": "prettier . --check",
        "prettier-write": "prettier . --write",
        "cf-build": "opennextjs-cloudflare build",
        "cf-preview": "pnpm run cf-build && opennextjs-cloudflare preview",
        "cf-deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "cf-deploy-preview": "pnpm exec wrangler versions upload",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
    },
    "dependencies": {
        "@opennextjs/cloudflare": "^1",
        "dayjs": "^1",
        "next": "^16",
        "react": "^19",
        "react-dom": "^19"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^26",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/parser": "^8",
        "autoprefixer": "^10",
        "daisyui": "^5",
        "esbuild": "^0.28",
        "eslint": "^9",
        "eslint-config-next": "^16",
        "eslint-config-prettier": "^10",
        "eslint-plugin-prettier": "^5",
        "import-sort-style-module": "^6",
        "postcss": "^8",
        "prettier": "^3",
        "prettier-plugin-import-sort": "latest",
        "prettier-plugin-tailwindcss": "latest",
        "tailwindcss": "^4",
        "typescript": "^6",
        "typescript-eslint": "^8",
        "wrangler": "^4"
    },
    "importSort": {
        ".js, .jsx, .ts, .tsx": {
            "style": "module",
            "parser": "typescript"
        }
    },
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
